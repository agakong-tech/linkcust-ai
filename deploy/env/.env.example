# Runtime
NODE_ENV=production
SERVER_URL=https://app.tt.linkcust.com
FRONT_BASE_URL=https://app.tt.linkcust.com

# Image repository (IMAGE_TAG is injected by Jenkins/deploy.sh)
HARBOR_REGISTRY=harbor.example.com
HARBOR_PROJECT=linkcust
IMAGE_NAME=linkcust-ai
IMAGE_TAG=develop

# External PostgreSQL
PG_DATABASE_URL=postgres://linkcust:CHANGE_ME@postgres-host:5432/linkcust

# External Redis
REDIS_URL=redis://:CHANGE_ME@redis-host:6379/0

# Application secrets
ACCESS_TOKEN_SECRET=CHANGE_ME
LOGIN_TOKEN_SECRET=CHANGE_ME
REFRESH_TOKEN_SECRET=CHANGE_ME
FILE_TOKEN_SECRET=CHANGE_ME

# Storage - adapt to the provider in use
STORAGE_TYPE=local

# Deployment
APP_HTTP_PORT=3000
HEALTHCHECK_URL=http://127.0.0.1:3000/healthz
HEALTHCHECK_RETRIES=30
HEALTHCHECK_INTERVAL_SECONDS=5
